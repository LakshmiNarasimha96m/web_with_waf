{
  "version": 2,
  "env": {
    "WAF_URL": "https://firewall-o5y1.onrender.com"
  },
  "build": {
    "env": {
      "WAF_URL": "https://firewall-o5y1.onrender.com"
    }
  },
  "routes": [
    { "src": "^/api/(.*)", "dest": "/api/$1.js" },
    { "handle": "filesystem" },
    { "src": "^/$", "dest": "/public/index.html" },
    { "src": "^/(?!api/)(.+)$", "dest": "/public/$1" }
  ]
}
